[DEFAULT]
banaction = iptables-allports
ignoreip = 127.0.0.1/8
usedns = no
backend = polling
bantime = 10m
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
bantime.rndtime = 30s

[sshd]
enabled = false

[sshd-ddos]
enabled = false

[http-flood]
enabled = true
port = http,https
filter = http-flood
logpath = /var/log/nginx/access.log
maxretry = 60
findtime = 10s

[ldap-tls]
enabled = true
port = 636,389
filter = ldap-tls
logpath = /var/log/nginx/ldap-tls.log
maxretry = 10
findtime = 60s
bantime = 30m